
# Vacuum Cleaner Problem using AI

rooms = {
    'A': 'Dirty',
    'B': 'Dirty'
}

location = 'A'

print("Initial Room Status:")
print(rooms)

while 'Dirty' in rooms.values():

    print("\nVacuum Cleaner is in Room", location)

    if rooms[location] == 'Dirty':
        print("Room", location, "is Dirty")
        print("Cleaning Room", location)
        rooms[location] = 'Clean'

    else:
        print("Room", location, "is already Clean")

    if location == 'A':
        location = 'B'
    else:
        location = 'A'

print("\nAll Rooms are Clean!")
print("Final Room Status:")
print(rooms)

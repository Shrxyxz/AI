      "source": [
        "# Forward Chaining in First Order Logic\n",
        "\n",
        "# Facts\n",
        "facts = {\n",
        "    (\"Human\", \"John\"),\n",
        "    (\"Human\", \"Alice\")\n",
        "}\n",
        "\n",
        "# Rules\n",
        "# If X is Human, then X is Mortal\n",
        "rules = [\n",
        "    {\n",
        "        \"premise\": [(\"Human\", \"x\")],\n",
        "        \"conclusion\": (\"Mortal\", \"x\")\n",
        "    },\n",
        "    {\n",
        "        \"premise\": [(\"Mortal\", \"x\")],\n",
        "        \"conclusion\": (\"CanDie\", \"x\")\n",
        "    }\n",
        "]\n",
        "\n",
        "\n",
        "def forward_chaining(facts, rules):\n",
        "    inferred = True\n",
        "\n",
        "    while inferred:\n",
        "        inferred = False\n",
        "\n",
        "        for rule in rules:\n",
        "            premise = rule[\"premise\"]\n",
        "            conclusion = rule[\"conclusion\"]\n",
        "\n",
        "            for fact in list(facts):\n",
        "                if fact[0] == premise[0][0]:\n",
        "                    variable = premise[0][1]\n",
        "\n",
        "                    new_fact = (\n",
        "                        conclusion[0],\n",
        "                        fact[1] if conclusion[1] == variable\n",
        "                        else conclusion[1]\n",
        "                    )\n",
        "\n",
        "                    if new_fact not in facts:\n",
        "                        facts.add(new_fact)\n",
        "                        inferred = True\n",
        "                        print(\"New Fact:\", new_fact)\n",
        "\n",
        "    return facts\n",
        "\n",
        "\n",
        "# Execute\n",
        "result = forward_chaining(facts, rules)\n",
        "\n",
        "print(\"\\nFinal Facts:\")\n",
        "for fact in sorted(result):\n",
        "    print(fact)"
      ]
    }
